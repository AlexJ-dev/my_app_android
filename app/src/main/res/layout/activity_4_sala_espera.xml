<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/beige_background"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:src="@drawable/back_icon"
        android:layout_gravity="start"
        android:layout_margin="12dp"/>
    <include
        android:id="@+id/textSala"
        layout="@layout/componente_imagen_logo">
    </include>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerMensajes"
        android:layout_width="match_parent"
        android:background="@color/beige_background"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="16dp"
        android:orientation="horizontal"
        android:layout_marginVertical="20dp"
        android:layout_gravity="center"/>
    <include
        android:id="@+id/customButtonLayout"
        layout="@layout/componente_boton_perzonalizado"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        app:menu="@menu/menu_navigation"
        app:itemIconTint="@color/gray_background"
        app:itemTextColor="@color/gray_background"/>

</LinearLayout>